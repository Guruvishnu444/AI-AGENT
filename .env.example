# =============================================================================
#                    VISHNU'S ULTRON — ENVIRONMENT SECRETS
# =============================================================================

# --- 1. LiveKit Cloud (Required for Real-Time Voice WebRTC) ---
# Sign up (free tier) at: https://cloud.livekit.io
# Project Settings -> Keys -> Create Key
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LIVEKIT_AGENT_NAME=ultron

# --- 2. Google Gemini API (Required for default LLM reasoning) ---
# Get key (free tier available) at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 3. OpenAI API (Required for default Whisper STT & Onyx Ultron TTS) ---
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 4. Alternative Providers (Optional) ---
# Sarvam AI (Optimized Indian-English STT/TTS: https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Deepgram (Ultra-low latency STT: https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Groq (Alternative ultra-fast open LLMs: https://console.groq.com)
GROQ_API_KEY=

# --- 5. Persona & Runtime Configuration ---
SERVER_NAME="Vishnu's ULTRON"
CREATOR_NAME="Vishnu"
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Active Pipeline Selections
LLM_PROVIDER=gemini          # Options: "gemini" | "openai"
STT_PROVIDER=whisper         # Options: "whisper" | "sarvam"
TTS_PROVIDER=openai          # Options: "openai" | "sarvam"
OPENAI_TTS_VOICE=onyx        # "onyx" (Ultron deep authoritative voice) | "echo" | "nova"
TTS_SPEED=1.05
